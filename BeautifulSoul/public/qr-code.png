<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200" width="200" height="200">
  <defs>
    <linearGradient id="qrGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#ec4899;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#db2777;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="200" height="200" fill="white"/>
  
  <!-- QR-like pattern -->
  <rect x="10" y="10" width="30" height="30" fill="url(#qrGradient)"/>
  <rect x="50" y="10" width="5" height="30" fill="#db2777"/>
  <rect x="70" y="10" width="15" height="30" fill="#db2777"/>
  <rect x="100" y="10" width="30" height="30" fill="url(#qrGradient)"/>
  <rect x="150" y="10" width="40" height="30" fill="#db2777"/>
  
  <rect x="10" y="50" width="15" height="20" fill="#db2777"/>
  <rect x="40" y="50" width="25" height="20" fill="url(#qrGradient)"/>
  <rect x="85" y="50" width="20" height="20" fill="#db2777"/>
  <rect x="130" y="50" width="30" height="20" fill="url(#qrGradient)"/>
  
  <rect x="20" y="85" width="30" height="30" fill="url(#qrGradient)"/>
  <rect x="70" y="85" width="25" height="30" fill="#db2777"/>
  <rect x="115" y="85" width="25" height="30" fill="url(#qrGradient)"/>
  
  <rect x="15" y="130" width="25" height="30" fill="#db2777"/>
  <rect x="55" y="130" width="30" height="30" fill="url(#qrGradient)"/>
  <rect x="105" y="130" width="20" height="30" fill="#db2777"/>
  <rect x="140" y="130" width="30" height="30" fill="url(#qrGradient)"/>
  
  <rect x="10" y="170" width="40" height="20" fill="url(#qrGradient)"/>
  <rect x="60" y="170" width="20" height="20" fill="#db2777"/>
  <rect x="90" y="170" width="35" height="20" fill="url(#qrGradient)"/>
  <rect x="145" y="170" width="45" height="20" fill="#db2777"/>
  
  <!-- Heart in center -->
  <text x="100" y="105" font-size="30" text-anchor="middle" fill="#ec4899">❤️</text>
</svg>
